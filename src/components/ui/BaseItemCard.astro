---
import Icon from "./Icon.astro";
import { renderInlineMarkdown } from "../../utils/markdown";

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    authors?: string;
    extraInput?: string;
    paperReference?: string;
    paperUrl?: string;
    tags?: string[];
    externalUrl?: string;
    externalLabel?: string;
}

const {
    title,
    href,
    description,
    date,
    authors,
    extraInput,
    paperReference,
    paperUrl,
    tags,
    externalUrl,
    externalLabel = "View external",
} = Astro.props;

const paperLinkIsExternal = paperUrl?.startsWith("http");
const descriptionHtml = description
    ? await renderInlineMarkdown(description)
    : undefined;
---

<article class="card agenda">
    <div class="agenda-date">{date}</div>

    <div class="card-content">
        <a href={href} class="card-title">{title}</a>

        {(authors || extraInput) && (
            <div class="card-meta">
                {authors && (
                    <span class="flex items-center gap-1">
                        <Icon name="User" size={18} />
                        <span>{authors}</span>
                    </span>
                )}
                {extraInput && (
                    <span class="flex items-center gap-1">
                        <Icon name="Institution" size={18} />
                        <span>{extraInput}</span>
                    </span>
                )}
            </div>
        )}

        {paperReference && (
            <p class="paper-reference">
                <span>Paper</span>{" "}
                {paperUrl ? (
                    <a
                        href={paperUrl}
                        target={paperLinkIsExternal ? "_blank" : undefined}
                        rel={paperLinkIsExternal ? "noopener noreferrer" : undefined}
                    >
                        {paperReference}
                    </a>
                ) : paperReference}
            </p>
        )}

        {descriptionHtml && <p class="card-desc" set:html={descriptionHtml} />}

        {tags && tags.length > 0 && (
            <ul class="chip-list" aria-label="Topics">
                {tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
        )}

        {externalUrl && (
            <div class="pill-row">
                <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="pill">
                    {externalLabel}
                    <Icon name="ExternalLink" size={13} />
                </a>
            </div>
        )}
    </div>
</article>
